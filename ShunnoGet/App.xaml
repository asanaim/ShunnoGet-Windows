             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppleBlueBrush" Color="#0A84FF"/>
        <SolidColorBrush x:Key="AppleDeepBlueBrush" Color="#0040DD"/>
        <SolidColorBrush x:Key="AppleGreenBrush" Color="#30D158"/>
        <SolidColorBrush x:Key="AppleOrangeBrush" Color="#FF9F0A"/>
        <SolidColorBrush x:Key="AppleRedBrush" Color="#FF3B30"/>
        <SolidColorBrush x:Key="AppleBgBrush" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="AppleCardBrush" Color="#FFFFFF"/>
