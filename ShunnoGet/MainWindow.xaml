<Window x:Class="ShunnoGet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shunno Get — Multi-Threaded Download Manager"
        Width="980" Height="680"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F7"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Apple Cupertino Top Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Sculpted "0↓" Squircle Logo Badge -->
            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="13" Margin="0,0,14,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0A84FF" Offset="0.0"/>
                        <GradientStop Color="#0051D5" Offset="0.55"/>
                        <GradientStop Color="#002B7F" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Ellipse Width="28" Height="34" Stroke="White" StrokeThickness="3.2" Fill="#22FFFFFF"/>
                    <TextBlock Text="↓" Foreground="#30D158" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Shunno Get" FontSize="26" FontWeight="Bold" Foreground="#1C1C1E"/>
                <TextBlock Text="Up to 32 Parallel HTTP Range Threads • HLS (.m3u8) • Lossless FLAC/ALAC • SHA-256 Verified"
                           FontSize="12" Foreground="#8E8E93"/>
            </StackPanel>

            <!-- Quick Desktop Controls: Clipboard Sniffer & Speed Limiter -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ClipboardMonitorToggle" Content="📋 Auto-Sniff Clipboard Links"
                          IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"
                          FontWeight="SemiBold" Foreground="#1C1C1E"/>

                <Border Background="White" CornerRadius="10" Padding="10,6" BorderBrush="#E5E5EA" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Speed Limit:" FontSize="12" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="SpeedLimitCombo" Width="110" SelectedIndex="0" SelectionChanged="SpeedLimitCombo_SelectionChanged">
                            <ComboBoxItem Content="Unlimited"/>
                            <ComboBoxItem Content="10 MB/s"/>
                            <ComboBoxItem Content="5 MB/s"/>
                            <ComboBoxItem Content="2 MB/s"/>
                            <ComboBoxItem Content="512 KB/s"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Row 1: URL Input & Batch Acceleration Card -->
        <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="16" Margin="0,0,0,14"
                BorderBrush="#E5E5EA" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="UrlInputBox" Grid.Column="0" Height="38" VerticalContentAlignment="Center"
                             Padding="10,0" FontSize="13"
                             ToolTip="Paste direct HTTP/HTTPS URL, .flac/.mp4/.m3u8 stream, or wildcard pattern like https://site.com/track_[01-12].flac"/>

                    <ComboBox x:Name="ThreadsCombo" Grid.Column="1" Width="120" Height="38" Margin="10,0,0,0"
                              VerticalContentAlignment="Center" SelectedIndex="3">
                        <ComboBoxItem Content="1 Thread"/>
                        <ComboBoxItem Content="4 Threads"/>
                        <ComboBoxItem Content="8 Threads"/>
                        <ComboBoxItem Content="16 Threads"/>
                        <ComboBoxItem Content="32 Threads"/>
                    </ComboBox>

                    <Button Grid.Column="2" Content="⚡ Start Download" Height="38" Padding="18,0" Margin="10,0,0,0"
                            Background="#0A84FF" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Click="StartDownload_Click"/>

                    <Button Grid.Column="3" Content="📄 Import .TXT Batch" Height="38" Padding="14,0" Margin="8,0,0,0"
                            Background="#F2F2F7" Foreground="#0A84FF" FontWeight="SemiBold" BorderThickness="0"
                            Click="ImportBatchTxt_Click"/>
                </Grid>

                <!-- Category Filter Pills & Optional Headers -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton Content="All" IsChecked="True" GroupName="Cat" Margin="0,0,12,0" Checked="CategoryFilter_Changed" FontWeight="SemiBold"/>
                        <RadioButton Content="Videos" GroupName="Cat" Margin="0,0,12,0" Checked="CategoryFilter_Changed"/>
                        <RadioButton Content="Lossless Audio" GroupName="Cat" Margin="0,0,12,0" Checked="CategoryFilter_Changed"/>
                        <RadioButton Content="Archives" GroupName="Cat" Margin="0,0,12,0" Checked="CategoryFilter_Changed"/>
                        <RadioButton Content="Programs" GroupName="Cat" Margin="0,0,12,0" Checked="CategoryFilter_Changed"/>
                        <RadioButton Content="Documents" GroupName="Cat" Margin="0,0,12,0" Checked="CategoryFilter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="📂 Open Downloads Folder" Background="Transparent" BorderThickness="0"
                                Foreground="#0A84FF" FontWeight="SemiBold" Cursor="Hand" Click="OpenDownloadsFolder_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Row 2: Active & Completed Downloads List -->
        <ListBox x:Name="DownloadsListBox" Grid.Row="2" Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="14" Padding="16,12" Margin="0,0,0,10"
                            BorderBrush="#E5E5EA" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- File Title & Size -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" Foreground="#1C1C1E" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding BadgeText}" FontSize="12" Foreground="#0A84FF" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SizeProgressText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#8E8E93" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Progress Bar -->
                            <ProgressBar Grid.Row="1" Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                         Height="8" Margin="0,8,0,8" Foreground="#0A84FF" Background="#E5E5EA" BorderThickness="0"/>

                            <!-- Live Telemetry & Action Buttons -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding TelemetryText}" FontSize="11.5" Foreground="#636366"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Pause" Padding="10,4" Margin="4,0,0,0" Background="#FFF5E5" Foreground="#FF9F0A"
                                            BorderThickness="0" FontWeight="SemiBold" Tag="{Binding}" Click="PauseItem_Click"/>
                                    <Button Content="Resume" Padding="10,4" Margin="4,0,0,0" Background="#EBF4FF" Foreground="#0A84FF"
                                            BorderThickness="0" FontWeight="SemiBold" Tag="{Binding}" Click="ResumeItem_Click"/>
                                    <Button Content="Fix Link" Padding="10,4" Margin="4,0,0,0" Background="#F2F2F7" Foreground="#1C1C1E"
                                            BorderThickness="0" FontWeight="SemiBold" Tag="{Binding}" Click="FixLinkItem_Click"/>
                                    <Button Content="Show File" Padding="10,4" Margin="4,0,0,0" Background="#E8F8EE" Foreground="#30D158"
                                            BorderThickness="0" FontWeight="SemiBold" Tag="{Binding}" Click="ShowFileItem_Click"/>
                                    <Button Content="✕" Padding="8,4" Margin="4,0,0,0" Background="#FFEBEA" Foreground="#FF3B30"
                                            BorderThickness="0" FontWeight="Bold" Tag="{Binding}" Click="DeleteItem_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Row 3: Status Footer -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatusText" Grid.Column="0"
                       Text="🌐 Browser Integration Active on http://127.0.0.1:45780/add • Wildcard Batch [01-50] Ready"
                       FontSize="11.5" Foreground="#8E8E93" VerticalAlignment="Center"/>
            <CheckBox x:Name="ShutdownWhenDoneToggle" Grid.Column="1" Content="Shut down PC when all downloads finish"
                      FontSize="11.5" Foreground="#8E8E93" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
